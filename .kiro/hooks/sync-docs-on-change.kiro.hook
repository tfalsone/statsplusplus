{
  "enabled": true,
  "name": "Sync Docs on Source Change",
  "description": "When Python source files, HTML templates, JS, CSS, or config files are edited, asks the agent to review the change and update the owning living documentation per the ownership map in docs/README.md.",
  "version": "2",
  "when": {
    "type": "fileEdited",
    "patterns": [
      "**/*.py",
      "**/*.html",
      "**/*.js",
      "**/*.css",
      "**/*.json",
      "requirements.txt"
    ]
  },
  "then": {
    "type": "askAgent",
    "prompt": "A source file was just edited. Determine if documentation needs updating using the doc-status system in docs/README.md. Step 1: find the edited path in the ownership map (docs/README.md section 2) to identify the owning LIVING doc(s). Step 2: if the change affects what that doc describes (interfaces, CLI tools, query functions, routes, DB schema, model behavior, conventions, directory structure), update the doc to match and bump its 'Last verified against code' header line and its registry row. Also update README.md, STRUCTURE.md, RULES.md, or PURPOSE.md if relevant. Do NOT touch Historical docs (they carry a frozen banner). If the change is cosmetic or does not affect documented behavior, do nothing."
  }
}
